TELEGRAM_BOT_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
DATABASE_PATH=./data/workshop.db

# WB: enter locally only, never through Telegram. Restart after changing.
# .env is plaintext: restrict filesystem permissions and backups.
WB_API_TOKEN=
# Optional legacy setting; no longer required for normal request pacing.
WB_API_PROFILE=

# Ozon Seller API: local only, restart after changes. Never send through Telegram.
# One configured account, explicitly attached by the workshop owner via /ozon attach.
OZON_CLIENT_ID=
OZON_API_KEY=

# Day 26: optional local speech input (all paths relative to working directory)
SPEECH_ENABLED=false
SPEECH_PROVIDER=gigaam
SPEECH_MODEL_PATH=assets/gigaam-v3-ctc
SPEECH_RUNTIME_PATH=assets/onnxruntime/onnxruntime.dll
SPEECH_DEVICE=auto
SPEECH_CPU_FALLBACK=true
SPEECH_MAX_FILE_SIZE_MB=20
SPEECH_MAX_DURATION=120s
SPEECH_TIMEOUT=90s
SPEECH_MAX_CONCURRENT_JOBS=1

# Show recognized voice text before normal command handling.
TELEGRAM_VOICE_SHOW_TRANSCRIPT=true
