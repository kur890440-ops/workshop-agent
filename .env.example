TELEGRAM_BOT_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
DATABASE_PATH=./data/workshop.db

# WB: enter locally only, never through Telegram. Restart after changing.
# .env is plaintext: restrict filesystem permissions and backups.
WB_API_TOKEN=
# Optional legacy setting; no longer required for normal request pacing.
WB_API_PROFILE=

# Ozon Seller API: local only, restart after changes. Never send through Telegram.
# One configured account, explicitly attached by the workshop owner via /ozon attach.
OZON_CLIENT_ID=
OZON_API_KEY=

# Day 26: optional local speech input (all paths relative to working directory)
SPEECH_ENABLED=false
SPEECH_PROVIDER=gigaam
SPEECH_MODEL_PATH=assets/gigaam-v3-ctc
SPEECH_RUNTIME_PATH=assets/onnxruntime/onnxruntime.dll
SPEECH_DEVICE=auto
SPEECH_CPU_FALLBACK=true
SPEECH_MAX_FILE_SIZE_MB=20
SPEECH_MAX_DURATION=120s
SPEECH_TIMEOUT=90s
SPEECH_MAX_CONCURRENT_JOBS=1

# Show recognized voice text before normal command handling.
TELEGRAM_VOICE_SHOW_TRANSCRIPT=true

# Day30 Web Chat, served inside workshop-agent.exe. HTTPS via trusted reverse proxy in production.
WEB_ENABLED=false
WEB_LISTEN_ADDRESS=127.0.0.1:8080
WEB_PUBLIC_BASE_URL=http://127.0.0.1:8080
WEB_SESSION_TTL=12h
WEB_LOGIN_CODE_TTL=2m
# Comma-separated proxy CIDRs; proxy must overwrite X-Forwarded-Proto and append X-Forwarded-For.
WEB_TRUSTED_PROXIES=


# Day30 hybrid LLM. Ollama must run locally; models are never downloaded.
LLM_MODE=AUTO
LLM_LOCAL_BASE_URL=http://127.0.0.1:11434
# Exact installed tag verified via /api/tags. Empty = discover installed Qwen3 4B.
LLM_LOCAL_MODEL=qwen3:4b-q4_K_M
LLM_LOCAL_TIMEOUT=90s
# Cloud uses existing LLM_API_KEY, LLM_BASE_URL and LLM_MODEL.
LLM_CLOUD_PROVIDER=openrouter
LLM_CLOUD_TIMEOUT=60s

# Day30 process-wide admission defaults; validated SQLite /limits overrides win.
LIMIT_RATE=20
LIMIT_LOCAL_CONCURRENCY=1
LIMIT_CLOUD_CONCURRENCY=2
LIMIT_QUEUE=5
LIMIT_MAX_CONTEXT=16384
LIMIT_MAX_OUTPUT=2048
LIMIT_REQUEST_TIMEOUT=120
# Hardware safety ceiling; raise only after validating VRAM/model concurrency.
LIMIT_LOCAL_CAPACITY=1
